# 複製成 deploy/.env 後再改值。deploy/.env 不進版控（見 .gitignore）。
#
#   cp deploy/.env.example deploy/.env
#
# ⚠️ 這個檔必須是 LF 行尾（.gitattributes 已強制）。CRLF 會讓 docker compose
# 讀到的每個值都夾帶一個尾端 \r——密碼變成「密碼加一個看不見的字元」，
# 認證永遠失敗，而錯誤訊息只會說 access denied，完全指不到真因。

# ── MySQL：帳務寫入主庫 ──────────────────────────────────────────
MYSQL_ROOT_PASSWORD=change_me_root
MYSQL_DATABASE=lucky_star_casino
MYSQL_USER=lucky_user
MYSQL_PASSWORD=change_me
MYSQL_HOST=localhost
# 3308：團隊 repo 的 lucky-star-mysql 占著 3307，兩套要能同時跑
MYSQL_PORT=3308

# ── MongoDB：CQRS 讀端投影 + 局紀錄 ──────────────────────────────
MONGO_ROOT_USER=lucky_admin
MONGO_ROOT_PASSWORD=change_me
MONGO_DATABASE=lucky_star_read
MONGO_HOST=localhost
# 27018 而不是預設 27017：27017 留給開發者自己在本機裝的 MongoDB
MONGO_PORT=27018

# ── Redis：分散式鎖 / ZSET 排行榜 / 捕魚 session ──────────────────
# ⚠️ 這是主儲存不是快取，`down -v` 會砍掉業務資料
REDIS_HOST=localhost
REDIS_PORT=6380

# ── Kafka ────────────────────────────────────────────────────────
# 9095：團隊是 9092、lucky-star-notify-go 是 9094
KAFKA_HOST_PORT=9095
KAFKA_BOOTSTRAP_SERVERS=localhost:9095

# ── 服務間共用 ───────────────────────────────────────────────────
# INTERNAL_SECRET 保護所有 /internal/** 端點（對齊 Java 的 InternalSecretFilter，
# header 是 X-Internal-Secret）。⚠️ **沒有預設值，沒設就開不起來**——
# 空值會讓服務間端點對全世界敞開，而服務看起來完全正常。
INTERNAL_SECRET=change_me_internal

# log 等級：debug / info / warn / error（預設 info）
# ⚠️ 打錯字是錯誤不是靜默走預設：LOG_LEVEL=verbose 會讓服務拒絕啟動，
# 而不是讓你以為自己開了詳細日誌。
LOG_LEVEL=info

# ── wallet 服務 ──────────────────────────────────────────────────
# 8182 = Java 版的 8082 + 100。三套環境要能同時跑（地雷 #28），
# 本專案的業務服務一律是「Java 版的埠 + 100」：
#   gateway 8180 / member 8181 / wallet 8182 / game 8183 / rank 8184 / admin 8186
# ⚠️ 8088 已經被 lucky-star-notify-go 用掉了，所以不走「+1」那套。
WALLET_HTTP_PORT=8182

# 把 GORM 產生的 SQL 印進結構化 log（預設 true）。
# ⚠️ 這是 wallet 刻意與其他服務不同的地方（藍圖 §3.2）：帳務正確性建立在
# 冪等鍵的 UNIQUE 衝突與樂觀鎖的受影響列數上，而那正是 ORM 最會騙人的地方。
# 壓測時才關掉。
WALLET_SQL_LOG=true

# ── wallet 的 Transactional Outbox 投遞器 ────────────────────────
# 三個值都對齊 Java 版的 wallet.outbox.*，因為它們是團隊 T-090 壓測
# （2026-07-23）調出來的，不是隨手填的。
#
# 投遞上限 ≈ BATCH_SIZE / POLL_INTERVAL（500 / 0.2s ≈ 2,500 events/s）。
# ⚠️ 時距一律帶單位（200ms / 5s / 24h）：Java 那邊是 poll-interval-ms，
# 單位藏在名字裡，照搬過來會變成「200 到底是毫秒還是秒」。
WALLET_OUTBOX_POLL_INTERVAL=200ms
WALLET_OUTBOX_BATCH_SIZE=500

# SENT 的列保留幾天才刪。⚠️ **只刪 SENT**，PENDING 無論多舊都不刪——
# 刪掉就是無聲丟失事件，正是 Outbox 要防的事（地雷 #5）。
# 7 天與下游去重標記的 TTL 對齊（都對應「最大重送窗口」）。
WALLET_OUTBOX_RETENTION_DAYS=7
